{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "settings": {
    "next": {
      "rootDir": ["apps/web/", "apps/docs/"]
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/dist/**",
    "**/release/**",
    "**/next-env.d.ts"
  ]
}
